<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="DuLieu">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="DanhMuc" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="MaDM">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="DM[0-9]{3}" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="TenDM">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
